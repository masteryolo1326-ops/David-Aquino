{
  "name": "version-zero",
  "version": "1.0.0",
  "private": true,
  "description": "Version Zero — reusable Remotion + Three.js pipeline for 9:16 'What If' science explainers",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "timeline": "python3 scripts/build_timeline.py",
    "audio": "python3 scripts/build_audio.py",
    "render:preview": "node scripts/render.mjs --preview",
    "render": "node scripts/render.mjs",
    "stills": "node scripts/stills.mjs",
    "validate": "bash scripts/validate.sh"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@react-three/fiber": "9.8.1",
    "@remotion/bundler": "4.0.535",
    "@remotion/cli": "4.0.535",
    "@remotion/renderer": "4.0.535",
    "@remotion/three": "4.0.535",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.535",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.180.0",
    "d3-geo": "3.1.1",
    "topojson-client": "3.1.0",
    "typescript": "5.9.3",
    "world-atlas": "2.0.2"
  }
}
