  "cues": [
    { "id": "c01", "gap": 0.0,  "group": "g01", "text": "What if the entire internet disappeared…", "highlight": [["entire internet", "cyan"]] },
    { "id": "c02", "gap": 0.45, "group": "g01", "text": "for just five seconds?", "highlight": [["five seconds", "coral"]] },
    { "id": "c03", "gap": 0.55, "group": "g02", "text": "Instantly,", "highlight": [] },
    { "id": "c04", "gap": 0.12, "group": "g02", "text": "billions of connections would stop responding.", "highlight": [["stop responding", "coral"]] },
    { "id": "c05", "gap": 0.4,  "group": "g03", "text": "Mid-sentence.", "highlight": [["Mid-sentence.", "coral"]] },
    { "id": "c06", "gap": 0.32, "group": "g03", "text": "Mid-game.", "highlight": [["Mid-game.", "coral"]] },
    { "id": "c07", "gap": 0.32, "group": "g03", "text": "Mid-update.", "highlight": [["Mid-update.", "coral"]] },
    { "id": "c08", "gap": 0.5,  "group": "g04", "text": "Card payments could stall.", "highlight": [["stall", "coral"]] },
    { "id": "c09", "gap": 0.3,  "group": "g05", "text": "Online services could time out.", "highlight": [["time out", "coral"]] },
    { "id": "c10", "gap": 0.45, "group": "g06", "text": "But not everything would stop.", "highlight": [["not everything", "cyan"]] },
    { "id": "c11", "gap": 0.5,  "group": "g07", "text": "The power would stay on.", "highlight": [["stay on", "cyan"]] },
    { "id": "c12", "gap": 0.3,  "group": "g08", "text": "Offline systems would keep running.", "highlight": [["keep running", "cyan"]] },
    { "id": "c13", "gap": 0.3,  "group": "g09", "text": "And some videos wouldn't even pause.", "highlight": [["wouldn't even pause", "cyan"]] },
    { "id": "c14", "gap": 0.25, "group": "g10", "text": "The next few seconds are already downloaded.", "highlight": [["already downloaded", "cyan"]] },
    { "id": "c15", "gap": 0.6,  "group": "g11", "segments": 2, "text": "Then, five seconds later,", "highlight": [] },
    { "id": "c16", "gap": 0.12, "group": "g11", "text": "the internet comes back.", "highlight": [["comes back", "cyan"]] },
    { "id": "c17", "gap": 0.4,  "group": "g12", "text": "Some apps recover right away.", "highlight": [["right away", "cyan"]] },
    { "id": "c18", "gap": 0.3,  "group": "g13", "text": "Others are still waiting to retry.", "highlight": [["waiting to retry", "amber"]] },
    { "id": "c19", "gap": 0.45, "group": "g14", "segments": 2, "text": "Because getting the connection back isn't the same as getting everything working again.",
      "highlight": [["connection back", "cyan"], ["everything working", "amber"]],
      "captionSplits": ["Because getting the connection back", "isn't the same as getting everything working again."] }
  ],
